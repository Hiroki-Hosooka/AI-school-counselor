# このファイルをコピーして .env.local を作り、実際の値を入れてください。
#   cp .env.example .env.local
# .env.local は .gitignore に含まれているため、コミットされません(秘密情報はここにだけ書く)。
#
# Next.js(npm run dev / npm run build)と、scripts/ 配下の自動テストスクリプトは、
# どちらも .env.local を読みます(scripts/_lib/test-env.mjs 参照)。
# 本番(Vercel)の環境変数は、この仕組みとは別に、Vercelダッシュボードで設定してください
# (README.md「4. 環境変数を設定する」参照)。

# ---- 本番の会話生成に使う値(README.md 4節) ----------------------------------

# Google AI Studio(https://aistudio.google.com/apikey)で発行したキー。
GEMINI_API_KEY=

# Supabaseダッシュボード → Project Settings → API に表示される値。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 任意。Slack/DiscordのIncoming Webhook。危機判定時にセッションIDと時刻だけを送る
# (CLAUDE.md 5.3。相談本文は送らない)。
CRISIS_WEBHOOK_URL=

# 任意。既定60(1時間あたりの上限ターン数)。
RATE_LIMIT_PER_HOUR=

# 任意。管理画面(/admin.html)の合言葉。長く推測不能な値にすること
# (例: `openssl rand -hex 16` で生成)。"admin"のような値は絶対に使わないこと
# (CLAUDE.md 5.9。生徒の危機対応記録・相談内容が漏れる直接の原因になる)。
ADMIN_TOKEN=

# ---- 自動テスト専用(docs/prompts/structured-verification-suite.md) ----------
#
# 本番の GEMINI_API_KEY とは別の、合成テスト専用のキーを用意してください。
# 可能であれば別のGoogle Cloudプロジェクトで発行すること(CLAUDE.md 5.10)。
# 無料枠のデータはGoogleの製品改善に使われるため、実際の生徒の会話に使う本番キーとは
# 絶対に混ぜないでください。このキーは Vercel(本番)には絶対に設定しないこと。
#
# npm run test:crisis / test:ng-leak / test:relation-stability / test:persona-regression
# / test:all(まとめて実行)が、このキーを使います。未設定だとエラーで止まります
# (本番キーへのフォールバックはしません)。
TEST_GEMINI_API_KEY=

# 任意(2026年9月)。無料枠は1キーあたりのレート制限が厳しく、npm run test:all のような
# まとまった量の実行では頻繁に429で待たされることが実機検証で分かった。複数のキー
# (できれば別々のGoogle Cloudプロジェクトで発行したもの。それぞれ独立した無料枠になる)を
# カンマ区切りで設定すると、レート制限に当たった時に自動で次のキーへ切り替えて即再試行する
# (scripts/_lib/test-env.mjs の withRateLimitRetry 参照)。設定した場合はこちらが
# TEST_GEMINI_API_KEY より優先される(1件だけでも動くが、複数の方が効果が大きい)。
TEST_GEMINI_API_KEYS=

# 任意(2026年9月)。課金設定済みの単一キー。npm run test:model-comparison(モデルの
# コスト・パフォーマンス比較)、および課金キーに切り替えたテスト2/3/4-5専用で、
# PRIMARY_MODELSと同じ課金枠を使って測定するためのもの。TEST_GEMINI_API_KEY(S)の
# 無料枠プールとは別管理。このキーも合成データ専用であり、本番のGEMINI_API_KEYとは
# 別のキー/プロジェクトにすること(CLAUDE.md 5.10)。
TEST_GEMINI_API_KEY_PAID=

# 任意(2026年9月・既定1000)。課金キーを使うテスト全体で使ってよい上限(円)。
# scripts/_lib/test-env.mjsの予算台帳(docs/test-results/budget-ledger.json)が
# 実行前にこの値との比較で超過見込みを判定し、超えそうなら実行しない。
TEST_BUDGET_YEN=
